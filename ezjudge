function buildReducingParagraphs(){
  let paras = [];
  const confession = document.querySelector('input[name="confession"]:checked').value;
  let reductionCount = 0;
  if(confession === 'yes'){
    if(document.getElementById('extendedConfessionReason').checked){
      paras.push('按洗錢防制法第23條第3項前段規定，固須被告於偵查及歷次審判中均自白犯罪，方有適用，惟若檢察官就被告於偵查中已自白犯罪且事證明確之案件向法院聲請簡易判決處刑，致使被告無從於審判中有自白犯罪之機會，無異剝奪被告獲得減刑寬典之利益，顯非事理之平，故就此例外情況，只須被告於偵查中已自白犯罪，且於裁判前未提出任何否認犯罪之答辯，解釋上即有該規定之適用，俾符合該條規定之規範目的。查被告於偵查中坦承犯行，嗣檢察官向本院聲請簡易判決處刑，而被告於本院裁判前未提出否認犯罪之答辯，爰依洗錢防制法第23條第3項前段規定，減輕其刑。');
    } else {
      paras.push('被告於偵查中已自白犯行，爰依洗錢防制法第23條第3項前段規定，減輕其刑。');
    }
    reductionCount++;
  } else {
    paras.push('被告於偵查中固坦承提供帳戶，然否認有何幫助詐欺、洗錢之犯意，難認已合於自白之要件，自無從依洗錢防制法第23條第3項前段規定，減輕其刑。');
  }
  if(document.getElementById('helperReduce').checked){
    paras.push('被告為幫助犯，爰依刑法第30條第2項規定，按正犯之刑減輕之。');
    reductionCount++;
  }
  if(document.getElementById('surrender').checked){
    paras.push('被告於犯罪未被發覺前主動向偵查機關自首並接受裁判，爰依刑法第62條前段規定，減輕其刑。');
    reductionCount++;
  }
  if(reductionCount >= 2){
    paras.push('被告合於前開數種減輕原因，爰依刑法第70條規定，遞減其刑。');
  }
  return paras;
}

