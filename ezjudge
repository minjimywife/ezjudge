// ---------- amount formatting ----------
function formatAmount(raw){
  if(!raw) return '';
  const digits = String(raw).replace(/[^\d]/g, '');
  if(!digits) return '';
  const num = parseInt(digits, 10);
  if(isNaN(num) || num === 0) return '';
  const wan = Math.floor(num / 10000);
  const rest = num % 10000;
  if(wan > 0){
    if(rest === 0) return `${wan}萬元`;
    return `${wan}萬${rest.toLocaleString('en-US')}元`;
  }
  return `${num.toLocaleString('en-US')}元`;
}

// ---------- Chinese formal numeral (大寫) converter ----------
function toChineseFormal(num){
  num = Math.floor(Number(num) || 0);
  if(num === 0) return '零';
  const digitsCN = ['零','壹','貳','參','肆','伍','陸','柒','捌','玖'];
  const unitsCN = ['','拾','佰','仟'];
  const bigUnitsCN = ['','萬','億','兆'];

  let str = String(num);
  let groups = [];
  while(str.length > 0){
    groups.unshift(str.slice(-4));
    str = str.slice(0, -4);
  }

  let result = '';
  for(let i=0; i<groups.length; i++){
    const groupStr = groups[i];
    const groupNum = parseInt(groupStr, 10);
    const bigUnit = bigUnitsCN[groups.length-1-i] || '';
    if(groupNum === 0) continue;
    let groupResult = '';
    let started = false;
    let needZero = false;
    for(let j=0; j<groupStr.length; j++){
      const d = parseInt(groupStr[j], 10);
      const pos = groupStr.length - j - 1;
      if(d === 0){
        if(started) needZero = true;
      } else {
        if(needZero){ groupResult += '零'; needZero = false; }
        groupResult += digitsCN[d] + unitsCN[pos];
        started = true;
      }
    }
    result += groupResult + bigUnit;
  }
  return result.replace(/零+/g, '零') || '零';
}

function formatVerdictAmount(raw){
  if(!raw) return '';
  const num = parseInt(String(raw).replace(/[^\d]/g,''), 10);
  if(isNaN(num) || num === 0) return '';
  return toChineseFormal(num) + '元';
}

function formatVerdictCount(raw){
  const num = parseInt(String(raw).replace(/[^\d]/g,''), 10);
  if(isNaN(num)) return raw;
  return toChineseFormal(num);
}

