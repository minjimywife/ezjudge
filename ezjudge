    if(type==='refunded'){
      text = `${desc || '相關款項'}業經金融機構全數發還予被害人，爰不予宣告沒收或追徵。`;
    } else if(type==='drained'){
      text = `${desc || '相關款項'}均屬洗錢財物，惟業經提領一空，如仍宣告沒收，有過苛之虞，爰依刑法第38條之2第2項規定不予宣告沒收、追徵。`;
    } else if(type==='ml25Harsh'){
      text = `按洗錢防制法第25條第1項規定：「犯第19條、第20條之罪，洗錢之財物或財產上利益，不問屬於犯罪行為人與否，沒收之。」對於洗錢標的之財物或財產上利益，不問是否屬於行為人所有，均應依本條規定宣告沒收。又本條固係針對洗錢標的所設之特別沒收規定，然如沒收有過苛之虞，因前揭規定並未明文排除，仍應回歸適用刑法關於沒收之總則性規定，亦有刑法第38條之2第2項過苛條款之適用（最高法院114年度台上字第3105號判決意旨參照）。經查，${desc || '相關款項'}固屬經查獲之洗錢財物，惟業經轉匯一空，依卷內證據資料，無從證明被告就上開款項具事實上之管領處分權限，如仍為絕對義務沒收，猶有過苛，爰依刑法第38條之2第2項規定不予宣告沒收、追徵。`;
    } else if(type==='uncollectedItem'){
      text = `${desc || '相關物品'}係供犯罪所用之物，惟未據扣案，衡以該物品之性質、經掛失或補發後即失其作用，及國家執行沒收時所需耗費之成本與勞費，認欠缺刑法上沒收之重要性，爰依刑法第38條之2第2項規定，不另宣告沒收、追徵。`;
    } else if(type==='noProceeds'){
      text = `${desc ? desc+'，' : ''}查無證據證明被告因本案犯行獲有任何犯罪所得，爰不予宣告沒收、追徵。`;
    } else if(type==='lowValue'){
      text = `${desc || '相關物品'}價值輕微，縱屬供犯罪所用或所得之物，惟衡諸其經濟價值與國家執行沒收所需耗費之成本、勞費顯不相當，認欠缺刑法上沒收之重要性，爰依刑法第38條之2第2項規定，不予宣告沒收、追徵。`;
    } else if(type==='forfeit'){
      text = `${desc || '相關財物'}係被告因本案犯罪所得或供犯罪所用之物，爰依刑法第38條之1第1項（或第38條）規定宣告沒收，如全部或一部不能沒收或不宜執行沒收時，追徵其價額。`;
    } else {
      text = b.querySelector('.forf-custom').value.trim() || '（請填寫自訂沒收說明）';
    }
    return `　${marks[i]||('('+(i+1)+')')}${text}`;
  });
  return lines.join('\n');
}

