// 確保所有收合區塊依目前（未勾選）狀態正確顯示／隱藏，而非沿用 HTML 中殘留的 class
function syncToggleBox(boxId, show){
  const box = document.getElementById(boxId);
  if(box) box.classList.toggle('show', !!show);
}
