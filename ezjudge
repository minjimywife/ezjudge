function buildSentenceEstimate(){
  const box = document.getElementById('sentenceEstimate');
  if(!box) return;
  const checkedKeys = [...document.querySelectorAll('.crimeChk:checked')].map(c=>c.value).filter(v=>v!=='custom' && crimeData[v]);
  if(checkedKeys.length===0){
    box.innerHTML = '（尚未勾選任何有試算資料之罪名）';
    return;
  }

  const listLine = '<strong>已勾選罪名：</strong>' + checkedKeys.map(k=>crimeData[k].label).join('、');

  const mode = document.querySelector('input[name="concursus"]:checked').value;
  let lines = [listLine, ''];

  const commuteNote = (r)=>{
    if(r.legalMaxOriginal > 60){
      return `該罪法定最重本刑逾5年，依刑法第41條規定<strong style="color:#e08a7a">不得易科罰金</strong>；若宣告刑為6月以下有期徒刑或拘役，仍得依第41條第3項<strong>易服社會勞動</strong>（6小時折算1日）。`;
    }
    return `該罪法定最重本刑未逾5年，若宣告刑為6月以下有期徒刑或拘役，得依刑法第41條第1項<strong>易科罰金</strong>（1千元至3千元折算1日）；未聲請或不符者，得易服社會勞動。`;
  };

  if(mode === 'imagine' || mode === 'single'){
    const heavyKey = document.getElementById('heavierCrimeKey') ? document.getElementById('heavierCrimeKey').value : '';
    if(!heavyKey || !crimeData[heavyKey]){
      lines.push(`（請於「罪數關係」區塊選擇「主要罪名」以進行宣告刑試算）`);
    } else {
      const r = computeRangeFor(heavyKey);
      lines.push(`<strong>${mode === 'single' ? '所論罪名：' : '從一重論以：'}</strong>${r.label}`);
      lines.push(`<strong>試算宣告刑範圍：</strong>${monthsToText(r.min)} ～ ${monthsToText(r.max)}` + (r.recidivist? '（已計入累犯加重）':'') + (r.reductions.length? `（已依序遞減：${r.reductions.join('、')}）`:''));
      lines.push(`<strong>併科罰金：</strong>${fineTypeText[r.fineType]}${r.fineType!=='alternative' ? '（上限'+r.fineMax+'）' : ''}`);
      if(mode === 'imagine'){
        const others = checkedKeys.filter(k=>k!==heavyKey);
        if(others.length){
          lines.push(`<span style="color:var(--ink-soft)">想像競合僅依所從之重罪決定罰金種類；其餘輕罪（${others.map(k=>crimeData[k].label).join('、')}）之併科罰金規定不再單獨適用，附此敘明。</span>`);
        }
      }
      lines.push(commuteNote(r));
    }
  } else {
    lines.push('<strong>數罪併罰，各罪試算如下（尚未計入第51條定應執行刑）：</strong>');
    checkedKeys.forEach(k=>{
      const r = computeRangeFor(k);
      lines.push(`・${r.label}：${monthsToText(r.min)}～${monthsToText(r.max)}，${fineTypeText[r.fineType]}${r.fineType!=='alternative' ? '（上限'+r.fineMax+'）' : ''}`);
      lines.push(`　${commuteNote(r)}`);
    });
  }

  box.innerHTML = lines.filter(l=>l!=='').join('<br>');
}

// ---------- master render ----------
function render(){
  const out = document.getElementById('output');
  let sections = [];

  sections.push(buildCauseParagraph() + '\n\n　　主　文\n' + buildVerdictParagraph() + '\n\n　　事實及理由');

  sections.push('一、' + buildFactSource());

  const mil = buildMilitaryParagraph();
  if(mil) sections.push('二、' + mil);

  const sectionNo = mil ? '三' : '二';
  const marks = ['㈠','㈡','㈢','㈣','㈤','㈥','㈦','㈧','㈨','㈩'];

  // 依規定順序：
  // 1.法律變更 2.核被告所為 3.預備、未遂 4.吸收關係 5.接續犯 6.繼續犯 7.變更起訴法條
  // 8.共同正犯、幫助犯 9.想像競合／數罪併罰 10.檢察官誤會、疏漏部分 11.移送併辦部分
  // 12.加重事由 13.減輕事由
  let bodyParas = [];
  bodyParas = bodyParas.concat(buildAdvParagraph('advLegalChange', 'advLegalChangeText'));       // 1 法律變更
  bodyParas.push(buildCrimeParagraph());                                                          // 2 核被告所為
  bodyParas = bodyParas.concat(buildAdvParagraph('advPrepAttempt', 'advPrepAttemptText'));         // 3 預備、未遂
  bodyParas = bodyParas.concat(buildAdvParagraph('advAbsorption', 'advAbsorptionText'));           // 4 吸收關係
  bodyParas = bodyParas.concat(buildAdvParagraph('advContinuous', 'advContinuousText'));           // 5 接續犯
  bodyParas = bodyParas.concat(buildAdvParagraph('advOngoing', 'advOngoingText'));                 // 6 繼續犯
  bodyParas = bodyParas.concat(buildAdvParagraph('advChangeCharge', 'advChangeChargeText'));       // 7 變更起訴法條
  bodyParas = bodyParas.concat(buildJointHelperParagraphs());                                      // 8 共同正犯、幫助犯
  bodyParas = bodyParas.concat(buildConcursusTheoryParagraphs());                                  // 9 想像競合／數罪併罰
  bodyParas = bodyParas.concat(buildAdvParagraph('advProsecutorError', 'advProsecutorErrorText')); // 10 檢察官誤會、疏漏部分
  bodyParas = bodyParas.concat(buildJoinedCaseParagraph());                                        // 11 移送併辦部分
  bodyParas = bodyParas.concat(buildAggravatingParagraphs());                                      // 12 加重事由
  bodyParas = bodyParas.concat(buildReducingParagraphs());                                         // 13 減輕事由

  bodyParas.push(buildSentencingParagraph());
  const probation = buildProbationParagraph();
  if(probation) bodyParas.push(probation);
  bodyParas = bodyParas.filter(Boolean);
  const lunzuiBody = bodyParas.map((p,i)=>'　'+(marks[i]||('('+(i+1)+')'))+p).join('\n');
  sections.push(sectionNo + '、　　論罪科刑\n' + lunzuiBody);

  const forfeitNo = mil ? '四' : '三';
  sections.push(forfeitNo + '、沒收部分之說明\n' + buildForfeitureParagraph());

  const disposalNo = mil ? '五' : '四';
  const disposalLawLabels = {
    '449-1': '第449條第1項前段',
    '449-2': '第449條第2項',
    '449-3': '第449條第3項',
    '451-1-4': '第451條之1第4項',
    '454-2': '第454條第2項'
  };
  const disposalChecked = [...document.querySelectorAll('.disposalLaw:checked')].map(c=>c.value);
  const disposalText = disposalChecked.length
    ? '刑事訴訟法' + disposalChecked.map(v=>disposalLawLabels[v]).join('、')
    : '刑事訴訟法第449條第1項前段、第3項、第454條第2項';
  sections.push(disposalNo + '、據上論斷，依' + disposalText + '，逕以簡易判決處刑如主文。');

  const appealNo = mil ? '六' : '五';
  sections.push(appealNo + '、如不服本判決，得於判決書送達之翌日起20日內，以書狀敘述理由（應附繕本），向本院提起上訴。');

  const prosecutor = document.getElementById('prosecutorName').value.trim();
  if(prosecutor) sections.push(`本案經檢察官${prosecutor}聲請以簡易判決處刑${document.getElementById('hasJoinedCase').checked?'及移送併辦':''}。`);

  const y = document.getElementById('judgeDateYear').value.trim();
  const mo = document.getElementById('judgeDateMonth').value.trim();
  const d = document.getElementById('judgeDateDay').value.trim();
  const judgeDate = (y && mo && d) ? `${y}　年　　${mo}　月　　${d}　日` : '＿＿＿';
  const judgeName = document.getElementById('judgeName').value.trim();
  const clerkName = document.getElementById('clerkName').value.trim();
  let footer = [];
  footer.push(`中　　華　　民　　國　　${judgeDate}`);
  footer.push(`　　　　　　　　　${judgeName ? '橋頭簡易庭　法　官　'+judgeName : '（庭別）　法　官　＿＿＿'}`);
  footer.push('以上正本證明與原本無異。');
  footer.push('如不服本判決，應於判決送達之日起20日內向本院提出上訴書狀。');
  footer.push(`中　　華　　民　　國　　${judgeDate}`);
  footer.push(`　　　　　　　　　　 　　　　 書記官　${clerkName || '＿＿＿'}`);
  sections.push(footer.join('\n'));

  const probTable = buildProbationTable();
  let appendix = '\n附錄本案論罪科刑法條\n' + buildAppendixLaws();
  if(probTable) appendix += '\n\n' + probTable;

  out.textContent = sections.join('\n\n') + '\n' + appendix;
  buildSentenceEstimate();
  updateVerdictPreview();
  updateHeavyCrimeLawText();
  updateRangeHints();
  updateCommuteWarning();
}

function copyOutput(){
  const text = document.getElementById('output').textContent;
  navigator.clipboard.writeText(text).then(()=>{
    const toast = document.getElementById('toast');
    toast.classList.add('show');
    setTimeout(()=>toast.classList.remove('show'), 1600);
  });
}

function downloadOutput(){
  const text = document.getElementById('output').textContent;
  const blob = new Blob([text], {type:'text/plain;charset=utf-8'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = '刑事簡易判決書_事實及理由.txt';
  a.click();
}

