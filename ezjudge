  syncToggleBox('splitByItem_box', document.getElementById('splitByItem').checked);
  syncToggleBox('concursus_imagine_box', document.querySelector('input[name="concursus"]:checked').value === 'imagine');
  syncToggleBox('confession_yes_box', document.querySelector('input[name="confession"]:checked').value === 'yes');
  syncToggleBox('hasJoinedCase_box', document.getElementById('hasJoinedCase').checked);
  syncToggleBox('sentFactor_education_box', document.querySelector('.sentFactor[value="education"]').checked);
  syncToggleBox('hasProbation_box', document.getElementById('hasProbation').checked);
  syncToggleBox('hasCondition_box', document.getElementById('hasCondition').checked);
  syncToggleBox('dv38_box', document.querySelector('.probSupervision[value="dv38"]').checked);
  syncToggleBox('hasFineInVerdict_box', document.getElementById('hasFineInVerdict').checked);
  syncToggleBox('jointPrincipal_box', document.getElementById('jointPrincipal').checked);
  ['advLegalChange','advPrepAttempt','advAbsorption','advContinuous','advOngoing','advChangeCharge','advProsecutorError'].forEach(id=>{
    syncToggleBox(id+'_box', document.getElementById(id).checked);
