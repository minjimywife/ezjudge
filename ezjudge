function monthsToText(m){
  m = Math.round(m);
  if(m<=0) return '拘役或罰金（未達1月，僅供參考，實務多以拘役／罰金或最低刑度處理）';
  const y = Math.floor(m/12);
  const mm = m%12;
  let s = '';
  if(y>0) s += y+'年';
  if(mm>0 || y===0) s += mm+'月';
  return s;
}

