// ---------- sentence range estimator ----------
function computeRangeFor(key){
  const base = crimeData[key];
  if(!base) return null;
  let min = base.min, max = base.max;
  const legalMaxOriginal = base.max; // 未經個案加減之法定最高本刑，供刑法41條判斷用

  if(document.getElementById('recidivist').checked){
    min *= 1.5; max *= 1.5;
  }
  const reductions = [];
  if(document.getElementById('helperReduce').checked) reductions.push('幫助犯（刑法第30條第2項）');
  if(document.querySelector('input[name="confession"]:checked').value === 'yes') reductions.push('自白（洗錢防制法第23條第3項）');
  if(document.getElementById('surrender').checked) reductions.push('自首（刑法第62條）');
  reductions.forEach(()=>{ min /= 2; max /= 2; });

  return {label: base.label, min, max, fineType: base.fineType, fineMax: base.fineMax, legalMaxOriginal, reductions, recidivist: document.getElementById('recidivist').checked};
}

// ---------- verdict (主文) builder ----------
function buildVerdictParagraph(){
  const name = document.getElementById('defendantFullName').value.trim() || '被告';
  const monthsRaw = document.getElementById('mainPenaltyMonths').value.trim();
  if(!monthsRaw) return '（請於「主文量刑」填寫主刑月數以自動生成主文）';
  const monthsDisplay = formatVerdictCount(monthsRaw) + '月';

  const mode = document.querySelector('input[name="concursus"]:checked').value;
  let crimeLabel = '';
  let key = '';
  if(mode === 'imagine' || mode === 'single'){
    key = document.getElementById('heavierCrimeKey') ? document.getElementById('heavierCrimeKey').value : '';
    crimeLabel = verdictCrimeLabel[key] || '';
  }
  if(!crimeLabel){
    return '（請於「罪數關係」選擇「主要罪名」以自動生成主文；數罪併罰模式尚無法自動生成，請自行繕打）';
  }
  const verb = crimeVerb[key] || '犯';

  let out = `${name}${verb}${crimeLabel}，處有期徒刑${monthsDisplay}`;

  const hasFine = document.getElementById('hasFineInVerdict').checked;
  const fineRaw = document.getElementById('fineAmount').value.trim();
  const fineDisplay = hasFine ? formatVerdictAmount(fineRaw) : '';
  if(hasFine && fineDisplay){
    out += `，併科罰金新臺幣${fineDisplay}`;
  }
  out += '，有期徒刑如易科罰金';
  if(hasFine && fineDisplay) out += '，罰金如易服勞役';

  const rateRaw = document.querySelector('input[name="commuteRateChoice"]:checked').value;
  const rateDisplay = formatVerdictAmount(rateRaw);
  if(rateDisplay){
    out += `，均以新臺幣${rateDisplay}折算1日`;
  }
  out += '。';

  if(document.getElementById('hasProbation').checked){
    const years = document.getElementById('probationYears').value.trim() || '3';
    out += `緩刑${formatVerdictCount(years)}年`;
    if(document.getElementById('hasCondition').checked){
      const items = [...document.querySelectorAll('#conditionItems .repeat-block')];
      if(items.length){
        const deadlineMonths = document.getElementById('conditionDeadlineMonths').value.trim() || '＿＿';
        out += `，並應自本判決確定之日起${formatVerdictCount(deadlineMonths)}月內履行如附表所示條件`;
      }
    }
    const probChecked = [...document.querySelectorAll('.probSupervision:checked')];
    if(probChecked.length){
      out += '，並於緩刑期間付保護管束';
    }
    out += '。';
  }

  return out;
}

