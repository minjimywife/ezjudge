    if(blocks.length===0) return '（尚未新增附表編號對應罪名，請於左側「罪名」區塊新增）';
    return '核被告' + blocks.join('；') + '。';
  }
  const checked = [...document.querySelectorAll('.crimeChk:checked')].map(c=>c.value);
  const texts = checked.filter(v=>v!=='custom').map(v=>crimeText[v]);
