function buildNewEvidenceClause(){
  if(!document.getElementById('hasNewEvidence').checked) return '';
  const lines = document.getElementById('newEvidenceText').value.split('\n').map(s=>s.trim()).filter(Boolean);
  if(lines.length===0) return '';
  const marks = ['㈠','㈡','㈢','㈣','㈤','㈥','㈦','㈧'];
  return '\n　另補充下列證據，為認定本案犯罪事實之依據：\n' + lines.map((l,i)=>`　${marks[i]||('('+(i+1)+')')}${l}`).join('\n');
}

function buildFactSource(){
  const hasCorr = document.getElementById('hasCorrections').checked;
  const evidenceClause = buildNewEvidenceClause();

  if(!hasCorr){
    const v = document.querySelector('input[name="factSource"]:checked').value;
    let base;
    if(v === 'one') base = '本案犯罪事實及證據，均引用檢察官聲請簡易判決處刑書（如附件一）之記載。';
    else if(v === 'two') base = '本案犯罪事實及證據，均引用檢察官聲請簡易判決處刑書（如附件一）及移送併辦意旨書（如附件二）之記載。';
    else base = document.getElementById('factSource_custom').value.trim() || '（請填寫自訂事實引用文字）';
    return base + evidenceClause;
  }

  const mode = document.querySelector('input[name="correctionMode"]:checked').value;
  const items = [...document.querySelectorAll('#correctionItems .repeat-block')].map(b=>({
    topic: b.querySelector('.corr-topic').value.trim() || '＿＿',
    before: b.querySelector('.corr-before').value.trim(),
    connector: b.querySelector('.corr-connector').value.trim(),
    action: b.querySelector('.corr-action').value.trim() || '更正為',
    after: b.querySelector('.corr-after').value.trim() || '＿＿',
    quote: b.querySelector('.corr-quote').checked
  }));
  if(items.length===0) return '（尚未新增更正／補充項目）' + evidenceClause;

  const fragment = getFactSourceFragment();
  const marks = ['㈠','㈡','㈢','㈣','㈤','㈥','㈦','㈧'];
  const renderItem = (it)=> `${it.topic}${it.before?(it.quote?('「'+it.before+'」'):it.before):''}${it.connector}${it.action}${it.quote?('「'+it.after+'」'):it.after}`;

  if(mode === 'list'){
    const list = items.map((it,i)=>`　${marks[i]||('('+(i+1)+')')}${renderItem(it)}。`).join('\n');
    return `本案犯罪事實及證據，除均引用${fragment}外，餘更正、補充如下：\n${list}` + evidenceClause;
  } else {
    const joined = items.map(it=>renderItem(it)).join('、');
    return `本案犯罪事實及證據，除${joined}外，餘均引用${fragment}。` + evidenceClause;
  }
}

